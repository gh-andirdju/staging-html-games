{
  "name": "tetris",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bun wasm/build.js",
    "test:rust": "cargo test --locked --manifest-path wasm/Cargo.toml",
    "dev": "bun server.js",
    "dev:pages": "BASE_PATH=/html-games/tetris/ bun server.js",
    "test": "bunx playwright test",
    "test:pages": "APP_BASE_PATH=/html-games/tetris/ bunx playwright test",
    "test:external": "bunx playwright test",
    "test:headed": "bunx playwright test --headed",
    "test:ui": "bunx playwright test --ui",
    "playwright:install": "bunx playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
